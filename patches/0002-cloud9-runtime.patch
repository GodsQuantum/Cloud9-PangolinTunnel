+func envOrFile(key string) string {
+	if value := os.Getenv(key); value != "" {
+		return value
+	}
+
+	path := os.Getenv(key + "_FILE")
+	if path == "" {
+		return ""
+	}
+
+	data, err := os.ReadFile(path)
+	if err != nil {
+		log.WithError(err).Warnf("Unable to read %s_FILE", key)
+		return ""
+	}
+
+	return strings.TrimSpace(string(data))
+}
